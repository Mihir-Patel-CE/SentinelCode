# ==============================================================================
# SentinelCode - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="SentinelCode AI Code Review"
API_V1_STR="/api/v1"

# Security & Secrets (Generate strong random secrets in production)
# Example: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default (zero-configuration): sqlite:///./sentinelcode.db
# PostgreSQL production example: postgresql+psycopg2://user:password@localhost:5432/sentinelcode
DATABASE_URL=sqlite:///./sentinelcode.db

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI Provider Configuration
# Supported providers: mock, openai, gemini, anthropic, groq, ollama
# Default 'mock' provides intelligent heuristic analysis without requiring an API key
AI_PROVIDER=mock
AI_MODEL=sentinel-heuristic-v1

# Provider-Specific API Keys (leave blank if using AI_PROVIDER=mock)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Rate Limiting & Limits
MAX_CODE_LENGTH_BYTES=100000
RATE_LIMIT_PER_MINUTE=60
